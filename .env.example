# Google Cloud OAuth Client ID (Web application type) — see docs/technical-spec.md
# -> "Google Sheets API integration" for the one-time setup steps.
VITE_GOOGLE_CLIENT_ID=

# The spreadsheet ID from the Google Sheet's URL (the long ID between /d/ and /edit).
VITE_SPREADSHEET_ID=

# Server-only — used by api/lookup-food.ts. Never prefix this with VITE_,
# that would bundle it into client code.
ANTHROPIC_API_KEY=
