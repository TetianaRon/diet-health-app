# Google Cloud OAuth Client ID (Web application type) — see docs/technical-spec.md
# -> "Google Sheets API integration" for the one-time setup steps.
VITE_GOOGLE_CLIENT_ID=

# The spreadsheet ID from the Google Sheet's URL (the long ID between /d/ and /edit).
# Powers the "connect test sheet" button in Settings (one-tap switch, no
# pasting a link) — see getTestSpreadsheetId in src/lib/sheets.ts. Kept
# stable, matching whatever schema the currently-RELEASED app build expects —
# real testers connect here, so it should never be used for in-progress
# schema experiments (use VITE_DEV_SPREADSHEET_ID below for that instead).
VITE_SPREADSHEET_ID=

# Optional: powers the "connect Mom's sheet" button in Settings, which sets
# a device's spreadsheet override to this ID with one tap (no pasting a link).
# Leave blank to hide the button.
VITE_DEFAULT_SPREADSHEET_ID=

# Optional: powers the "connect dev sheet" button in Settings — the
# spreadsheet actual schema/data changes get tried against during active
# development, kept separate from VITE_SPREADSHEET_ID (test) so real testers
# on the currently-released build are never affected by in-progress work.
# Leave blank to hide the button.
VITE_DEV_SPREADSHEET_ID=

# Free API key for USDA FoodData Central — sign up at https://api.data.gov/signup/
# (no card required). Since 2026-09-28 it is NEVER sent to the browser: the app
# calls our proxy (api/usda.js), which adds the key on the server.
#   - Vercel: set USDA_API_KEY (no VITE_ prefix) in the project's env vars.
#   - Local `npm run dev`: vite.config.ts forwards /api/usda with USDA_API_KEY
#     (or the older VITE_USDA_API_KEY name, still read by the review scripts in
#     contributions/).
USDA_API_KEY=

# Only for builds that are NOT served from the web app's own domain — i.e. the
# Android (Capacitor) build: the absolute URL of the deployed proxy.
# VITE_USDA_PROXY_URL=https://track-my-meals.roncreator.com/api/usda

# Google Cloud Translation (since 1.5.2) — same pattern as USDA:
#   - Vercel: GOOGLE_TRANSLATE_API_KEY (no VITE_ prefix), restricted to the
#     Cloud Translation API; the project's daily quota is capped at 15,000
#     characters in Google Cloud (keeps it inside the free tier).
#   - Local `npm run dev`: vite.config.ts runs api/translate.js with this key;
#     without it, search still works for English words only.
#   - Android build: VITE_TRANSLATE_PROXY_URL points at the deployed proxy.
GOOGLE_TRANSLATE_API_KEY=
# VITE_TRANSLATE_PROXY_URL=https://track-my-meals.roncreator.com/api/translate

# Google Cloud OAuth Client ID (Android type) — used for the Android app's
# system-browser + PKCE sign-in flow (the Web application client above can't
# complete OAuth inside a Capacitor WebView, see docs/build-log.md's
# 2026-09-10 Android sign-in entry). Verified via package name
# (ca.roncreator.trackmymeals) + the signing certificate's SHA-1 fingerprint
# registered on this client in Google Cloud Console — no client secret for
# this client type. A "Desktop app" type client was tried first and rejected
# by Google (custom-scheme redirects need Android/iOS type, not Desktop) —
# see docs/technical-spec.md.
VITE_GOOGLE_ANDROID_CLIENT_ID=
