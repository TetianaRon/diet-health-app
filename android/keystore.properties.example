# Copy this file to keystore.properties (gitignored) in this same directory
# (android/) and fill in the real values, once the release keystore below
# has been generated. Needs a JDK — not possible on a machine without one
# (see docs/build-log.md's Capacitor/Android session for context).
#
# Generate the keystore ONCE, on build #1, and never regenerate it — every
# future release must be signed with the same key or Android will refuse to
# install the update over the existing app. Back it up somewhere outside
# this one dev machine (e.g. a password manager's file storage), since
# losing it means every future update requires users to uninstall/reinstall.
#
#   keytool -genkeypair -v -keystore trackmymeals-release.jks \
#     -alias trackmymeals -keyalg RSA -keysize 2048 -validity 10000
#
# keytool will prompt for a keystore password and a key password (can be the
# same value) plus your name/org details for the certificate — those don't
# need to be accurate, they're not user-facing.

storeFile=trackmymeals-release.jks
storePassword=REPLACE_ME
keyAlias=trackmymeals
keyPassword=REPLACE_ME
