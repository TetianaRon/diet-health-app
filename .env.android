# Loaded only by the Android build (`npm run build:android` = vite --mode android),
# on top of .env. Not secret: the app's web origin calls these same endpoints
# same-origin, while the Android WebView (https://localhost) needs absolute URLs.
# Keeping them out of .env means `npm run dev` and the web build use their own
# /api/* (the local Vite middleware / the deployment they're part of).
VITE_USDA_PROXY_URL=https://track-my-meals.roncreator.com/api/usda
VITE_TRANSLATE_PROXY_URL=https://track-my-meals.roncreator.com/api/translate
