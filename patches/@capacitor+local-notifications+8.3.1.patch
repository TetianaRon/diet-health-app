+    /**
+     * Track My Meals patch: records that a one-shot actually fired at `at`, so
+     * reboot-restore can tell a fired one from one that came due while the
+     * phone was off. Rescheduling the id replaces the record (and this mark).
+     */
+    fun setFiredAt(id: String, at: Long) {
+        val json = getSavedNotificationAsJSObject(id) ?: return
+        json.put("firedAt", at)
+        val editor = getStorage(NOTIFICATION_STORE_ID).edit()
+        editor.putString(id, json.toString())
+        editor.apply()
+    }
+
+    fun getFiredAt(id: String): Long? {
+        val json = getSavedNotificationAsJSObject(id) ?: return null
+        return if (json.has("firedAt")) json.optLong("firedAt") else null
+    }
+
     private fun getStorage(key: String): SharedPreferences =
         context.getSharedPreferences(key, Context.MODE_PRIVATE)
 
